# Supabase (required for blog + Google admin login)
# Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Optional: service role for one-time migration script only (never expose to the browser)
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional legacy Strapi URL (unused by the public blog):
# VITE_STRAPI_URL="https://light-upon-light-strapi.onrender.com"
# VITE_STRAPI_TOKEN=""

# PayPal REST app Client ID (Sandbox or Live) for the Donate page.
# Create an app at https://developer.paypal.com/dashboard/applications
VITE_PAYPAL_CLIENT_ID=""

# EmailJS (thank-you emails after PayPal donations).
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_ORG_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
# Where npm run test:email sends the sample thank-you message
TEST_DONATION_EMAIL=""
